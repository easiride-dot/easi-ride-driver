VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_key
VITE_VAPID_PUBLIC_KEY=your_vapid_public_key
VITE_PUSH_NOTIFICATIONS_API_KEY=your_push_api_key
VITE_API_URL=http://localhost:5000
# Mapbox token only needed if you opt into Mapbox tile rendering (VITE_MAP_PROVIDER=mapbox).
# Routing/geocoding now run server-side via Supabase edge functions — no token required.
# VITE_MAPBOX_ACCESS_TOKEN=your_mapbox_public_token
VITE_MAP_PROVIDER=maplibre # mapbox (optional tiles) or maplibre (default)
